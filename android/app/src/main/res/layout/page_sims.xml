<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageSims"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIM Cards"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:layout_marginBottom="16dp" />
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardLabel" android:text="DETECTED ON THIS PHONE" />
            <TextView
                android:id="@+id/tvDetectHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/textMuted"
                android:layout_marginTop="10dp" />
            <LinearLayout
                android:id="@+id/llDetectedSims"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp" />
        </LinearLayout>
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardLabel" android:text="MANUALLY REGISTERED" />
            <LinearLayout
                android:id="@+id/llManualSims"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp" />
        </LinearLayout>
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardLabel" android:text="ADD A SIM CARD" />
            <EditText
                android:id="@+id/etSimName"
                style="@style/AppInput"
                android:hint="Name (e.g. Personal)"
                android:inputType="textPersonName"
                android:layout_marginTop="14dp" />
            <EditText
                android:id="@+id/etSimNumber"
                style="@style/AppInput"
                android:hint="Number (e.g. +1234567890)"
                android:inputType="phone"
                android:layout_marginTop="10dp" />
            <EditText
                android:id="@+id/etSimCarrier"
                style="@style/AppInput"
                android:hint="Carrier (optional)"
                android:inputType="text"
                android:layout_marginTop="10dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIM slot:"
                    android:textSize="14sp"
                    android:textColor="@color/textMuted"
                    android:layout_marginEnd="12dp" />
                <Spinner
                    android:id="@+id/spinSimSlot"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <EditText
                android:id="@+id/etSimSubId"
                style="@style/AppInput"
                android:hint="Subscription ID (optional, e.g. 1)"
                android:inputType="number"
                android:layout_marginTop="10dp" />
            <Button
                android:id="@+id/btnAddSim"
                style="@style/BtnPrimary"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="Add SIM card" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="All SIM cards (detected + manual) are sent to the server on connect and every heartbeat (30s)."
                android:textSize="12sp"
                android:textColor="@color/textMuted"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
